generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  SOLICITANTE
  ENCARGADO
  PAGOS
  ADMIN

  @@map("rol_usuario")
}

model Sector {
  id            String    @id @default(uuid())
  nombre        String    @unique
  usuarios      Usuario[]
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  @@map("sectores")
}

model Usuario {
  id             String     @id @default(uuid())
  nombre         String
  email          String     @unique
  contrasenaHash String     @map("contrasena_hash")
  rol            RolUsuario
  activo         Boolean    @default(true)
  sectorId       String?    @map("sector_id")
  sector         Sector?    @relation(fields: [sectorId], references: [id])
  creadoEn       DateTime   @default(now()) @map("creado_en")
  actualizadoEn  DateTime   @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

enum TipoCuentaBancaria {
  CAJA_AHORRO
  CUENTA_CORRIENTE

  @@map("tipo_cuenta_bancaria")
}

model Cliente {
  id            String     @id @default(uuid())
  nombre        String
  rut           String     @unique
  email         String?
  telefono      String?
  proyectos     Proyecto[]
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  @@map("clientes")
}

model Proveedor {
  id            String             @id @default(uuid())
  nombre        String
  rut           String             @unique
  email         String?
  telefono      String?
  banco         String
  tipoCuenta    TipoCuentaBancaria @map("tipo_cuenta")
  numeroCuenta  String             @map("numero_cuenta")
  cotizaciones  Cotizacion[]
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")

  @@map("proveedores")
}

enum Moneda {
  UYU
  USD

  @@map("moneda")
}

enum EstadoCotizacion {
  ACTIVA
  REEMPLAZADA

  @@map("estado_cotizacion")
}

model Proyecto {
  id            String       @id @default(uuid())
  nombre        String
  clienteId     String       @map("cliente_id")
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  cotizaciones  Cotizacion[]
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  @@map("proyectos")
}

model Cotizacion {
  id             String           @id @default(uuid())
  proyectoId     String           @map("proyecto_id")
  proyecto       Proyecto         @relation(fields: [proyectoId], references: [id])
  proveedorId    String           @map("proveedor_id")
  proveedor      Proveedor        @relation(fields: [proveedorId], references: [id])
  montoTotal     Decimal          @map("monto_total") @db.Decimal(14, 2)
  moneda         Moneda
  estado         EstadoCotizacion @default(ACTIVA)
  archivoPdfRuta String?          @map("archivo_pdf_ruta")
  creadoEn       DateTime         @default(now()) @map("creado_en")
  actualizadoEn  DateTime         @updatedAt @map("actualizado_en")

  @@map("cotizaciones")
}
