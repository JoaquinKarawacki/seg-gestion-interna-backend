generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  SOLICITANTE
  ENCARGADO
  PAGOS
  ADMIN

  @@map("rol_usuario")
}

model Sector {
  id            String        @id @default(uuid())
  nombre        String        @unique
  usuarios      Usuario[]
  proyectos     Proyecto[]
  ordenesCompra OrdenCompra[]
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  @@map("sectores")
}

model Usuario {
  id                       String              @id @default(uuid())
  nombre                   String
  email                    String              @unique
  contrasenaHash           String              @map("contrasena_hash")
  rol                      RolUsuario
  activo                   Boolean             @default(true)
  sectorId                 String?             @map("sector_id")
  sector                   Sector?             @relation(fields: [sectorId], references: [id])
  historialEstadosOC       HistorialEstadoOC[]
  ordenesCompraSolicitadas OrdenCompra[]
  comentarios              Comentario[]
  auditorias               Auditoria[]
  creadoEn                 DateTime            @default(now()) @map("creado_en")
  actualizadoEn            DateTime            @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

enum TipoCuentaBancaria {
  CAJA_AHORRO
  CUENTA_CORRIENTE
  EXTERIOR

  @@map("tipo_cuenta_bancaria")
}

model Cliente {
  id            String        @id @default(uuid())
  nombre        String
  rut           String        @unique
  email         String?
  telefono      String?
  proyectos     Proyecto[]
  ordenesCompra OrdenCompra[]
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  @@map("clientes")
}

model Proveedor {
  id            String             @id @default(uuid())
  nombre        String
  rut           String             @unique
  email         String?
  telefono      String?
  banco         String
  tipoCuenta    TipoCuentaBancaria @map("tipo_cuenta")
  numeroCuenta  String             @map("numero_cuenta")
  cotizaciones  Cotizacion[]
  ordenesCompra OrdenCompra[]
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")

  @@map("proveedores")
}

enum Moneda {
  UYU
  USD
  EUR

  @@map("moneda")
}

enum EstadoCotizacion {
  ACTIVA
  REEMPLAZADA

  @@map("estado_cotizacion")
}

// UYU es la moneda base (tasa 1 implícita) — no tiene fila propia acá. Solo
// USD/EUR se guardan, se seedean en 1 para que el GET nunca truene antes de
// que un ADMIN los actualice.
model TipoCambio {
  id            String   @id @default(uuid())
  moneda        Moneda   @unique
  valorEnUyu    Decimal  @map("valor_en_uyu") @db.Decimal(14, 4)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("tipos_cambio")
}

model Proyecto {
  id                  String               @id @default(uuid())
  nombre              String
  clienteId           String               @map("cliente_id")
  cliente             Cliente              @relation(fields: [clienteId], references: [id])
  sectorId            String?              @map("sector_id")
  sector              Sector?              @relation(fields: [sectorId], references: [id])
  costoSegManual      Decimal?             @map("costo_seg_manual") @db.Decimal(14, 2)
  tareas              Tarea[]
  cotizaciones        Cotizacion[]
  propuestasInversion PropuestaInversion[]
  ordenesCompra       OrdenCompra[]
  creadoEn            DateTime             @default(now()) @map("creado_en")
  actualizadoEn       DateTime             @updatedAt @map("actualizado_en")

  @@map("proyectos")
}

model Tarea {
  id            String        @id @default(uuid())
  proyectoId    String        @map("proyecto_id")
  proyecto      Proyecto      @relation(fields: [proyectoId], references: [id])
  nombre        String
  cotizaciones  Cotizacion[]
  ordenesCompra OrdenCompra[]
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  @@map("tareas")
}

model Cotizacion {
  id             String           @id @default(uuid())
  proyectoId     String           @map("proyecto_id")
  proyecto       Proyecto         @relation(fields: [proyectoId], references: [id])
  tareaId        String           @map("tarea_id")
  tarea          Tarea            @relation(fields: [tareaId], references: [id])
  proveedorId    String           @map("proveedor_id")
  proveedor      Proveedor        @relation(fields: [proveedorId], references: [id])
  montoTotal     Decimal          @map("monto_total") @db.Decimal(14, 2)
  moneda         Moneda
  estado         EstadoCotizacion @default(ACTIVA)
  archivoPdfRuta String?          @map("archivo_pdf_ruta")
  ordenesCompra  OrdenCompra[]
  creadoEn       DateTime         @default(now()) @map("creado_en")
  actualizadoEn  DateTime         @updatedAt @map("actualizado_en")

  @@map("cotizaciones")
}

model PropuestaInversion {
  id                    String           @id @default(uuid())
  proyectoId            String           @map("proyecto_id")
  proyecto              Proyecto         @relation(fields: [proyectoId], references: [id])
  costoTotalAproximado  Decimal          @map("costo_total_aproximado") @db.Decimal(14, 2)
  ahorroMensual         Decimal          @map("ahorro_mensual") @db.Decimal(14, 2)
  cantidadMeses         Int              @map("cantidad_meses")
  porcentajeSeg         Decimal          @map("porcentaje_seg") @db.Decimal(5, 2)
  moneda                Moneda
  estado                EstadoCotizacion @default(ACTIVA)
  archivoRuta           String?          @map("archivo_ruta")
  archivoMimeType       String?          @map("archivo_mime_type")
  archivoNombreOriginal String?          @map("archivo_nombre_original")
  creadoEn              DateTime         @default(now()) @map("creado_en")
  actualizadoEn         DateTime         @updatedAt @map("actualizado_en")

  @@map("propuestas_inversion")
}

enum TipoOC {
  ARTICULO
  SERVICIO

  @@map("tipo_oc")
}

enum FormaPago {
  CONTADO_CONTRA_ENTREGA
  TARJETA_CREDITO
  DIFERIDO
  GIRO_RED_COBRANZA
  TRANSFERENCIA_BANCARIA

  @@map("forma_pago")
}

enum EstadoOC {
  BORRADOR
  PENDIENTE
  EN_CONSULTA
  APROBADO
  RECHAZADO
  PAGO_OBSERVADO
  PAGADO
  ANULADO

  @@map("estado_oc")
}

model OrdenCompra {
  id               String              @id @default(uuid())
  numero           Int                 @unique @default(autoincrement())
  tipo             TipoOC
  fecha            DateTime
  solicitanteId    String              @map("solicitante_id")
  solicitante      Usuario             @relation(fields: [solicitanteId], references: [id])
  sectorId         String              @map("sector_id")
  sector           Sector              @relation(fields: [sectorId], references: [id])
  proveedorId      String              @map("proveedor_id")
  proveedor        Proveedor           @relation(fields: [proveedorId], references: [id])
  clienteId        String?             @map("cliente_id")
  cliente          Cliente?            @relation(fields: [clienteId], references: [id])
  proyectoId       String?             @map("proyecto_id")
  proyecto         Proyecto?           @relation(fields: [proyectoId], references: [id])
  tareaId          String?             @map("tarea_id")
  tarea            Tarea?              @relation(fields: [tareaId], references: [id])
  cotizacionId     String?             @map("cotizacion_id")
  cotizacion       Cotizacion?         @relation(fields: [cotizacionId], references: [id])
  moneda           Moneda
  monto            Decimal             @map("monto") @db.Decimal(14, 2)
  concepto         String
  formaPago        FormaPago           @map("forma_pago")
  pagaIva          Boolean             @map("paga_iva")
  ivaIncluido      Boolean             @map("iva_incluido")
  observaciones    String?
  facturaPdfRuta   String?             @map("factura_pdf_ruta")
  estado           EstadoOC            @default(BORRADOR)
  historialEstados HistorialEstadoOC[]
  comentarios      Comentario[]
  creadoEn         DateTime            @default(now()) @map("creado_en")
  actualizadoEn    DateTime            @updatedAt @map("actualizado_en")

  @@map("ordenes_compra")
}

model HistorialEstadoOC {
  id             String      @id @default(uuid())
  ordenCompraId  String      @map("orden_compra_id")
  ordenCompra    OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  estadoAnterior EstadoOC    @map("estado_anterior")
  estadoNuevo    EstadoOC    @map("estado_nuevo")
  usuarioId      String      @map("usuario_id")
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  motivo         String?
  creadoEn       DateTime    @default(now()) @map("creado_en")

  @@map("historial_estado_oc")
}

model Comentario {
  id            String      @id @default(uuid())
  ordenCompraId String      @map("orden_compra_id")
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  autorId       String      @map("autor_id")
  autor         Usuario     @relation(fields: [autorId], references: [id])
  texto         String
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@map("comentarios")
}

model Auditoria {
  id           String   @id @default(uuid())
  usuarioId    String   @map("usuario_id")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioEmail String   @map("usuario_email")
  accion       String
  descripcion  String
  entidad      String?
  entidadId    String?  @map("entidad_id")
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("auditoria")
}
